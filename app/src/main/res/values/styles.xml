<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FinancialApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0D1117</item>
        <item name="android:navigationBarColor">#0D1117</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Tema flotante translúcido para apertura instantánea desde el widget (<50ms) -->
    <style name="Theme.FinancialApp.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">8dp</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.65</item>
    </style>
</resources>
